# Redcliffe Advisory — environment variables
#
# Local development: copy to .env.local and load it however you prefer, or pass
# the values inline (`DATABASE_URL=... npm start`).
# Vercel / Netlify: set these in the project's Environment Variables screen.
# See docs/DEPLOYMENT.md.
#
# The public website renders with zero variables set. Everything below only
# switches on the CMS, the admin portal and contact-form delivery.

# --- CMS + admin portal (all four required together) ------------------------
# Postgres connection string. Managed providers (Neon, Supabase, Vercel
# Postgres) already include ?sslmode=require — keep it.
DATABASE_URL=postgres://user:password@host:5432/radcliffe?sslmode=require
ADMIN_USERNAME=admin
# Use a long, random value. In production the app refuses to enable the admin
# portal unless ADMIN_PASSWORD and SESSION_SECRET are set.
ADMIN_PASSWORD=
SESSION_SECRET=

# --- Contact form email delivery (optional) ---------------------------------
# Without SMTP the messages are still stored in Postgres and readable in the
# admin portal. With SMTP they are also emailed on arrival.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FROM_EMAIL=
# Recipient used only when the CMS database is unavailable; normally the
# address is edited in the admin portal.
CONTACT_TO_EMAIL=karina.robinson@redcliffeadvisory.com

# --- Optional overrides -----------------------------------------------------
# Canonical site URL, used to generate robots.txt and sitemap.xml at build time.
SITE_URL=https://www.redcliffeadvisory.com
# PORT is only used by the long-lived Node server (Docker / Kubernetes).
PORT=3007
# Force TLS on/off for Postgres instead of inferring it from DATABASE_URL.
# DATABASE_SSL=true
# Skip the automatic schema/seed migration on boot.
# SKIP_DB_MIGRATION=true
# Re-run seeding even when the database already looks migrated.
# FORCE_DB_MIGRATION=true
# Maximum CMS image upload size in bytes (default 8 MB).
# MAX_UPLOAD_BYTES=8388608
